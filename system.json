{
    "id": "sra2-wired",
    "title": "Shadowrun Anarchy 2.0 - Wired",
    "description": "A modernized Shadowrun Anarchy 2 unofficial system for FoundryVTT",
    "version": "0.1.0",
    "license": "LICENSE.md",
    "url": "https://github.com/Kyle-B/sra2-wired",
    "manifest": "https://github.com/Kyle-B/sra2-wired/releases/latest/download/module.json",
    "download": "https://github.com/Kyle-B/sra2-wired/releases/latest/download/sra2-wired.zip",
    "compatibility": {
        "minimum": "14",
        "verified": "14.370",
        "maximum": "14"
    },
    "authors": [
        {
            "name": "The SRA2-Wired system developers",
            "url": "https://github.com/Kyle-B/sra2"
        },
        {
            "name": "The original SRA2 system developers",
            "url": "https://github.com/VincentVk9373/sra2"
        }
    ],
    "socket": true,
    "esmodules": ["sra2-wired.mjs"],
    "styles": ["styles/sra2-wired.css"],
    "languages": [
        {
            "lang": "en",
            "name": "English",
            "path": "lang/en.json"
        },
        {
            "lang": "fr",
            "name": "Français",
            "path": "lang/fr.json"
        }
    ],
    "grid": {
        "distance": 1,
        "units": "m"
    },
    "packs": [
