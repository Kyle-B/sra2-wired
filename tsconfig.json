{
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "isolatedModules": true,
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "noEmit": true,
        "paths": {
            "@system": ["./src/module/system/index.ts"],
            "@system/*": ["./src/module/system/*"],
            "@models/*": ["./src/module/models/*"],
            "@documents/*": ["./src/module/documents/*"],
            "@migration/*": ["./src/module/migration/*"],
            "@ui/*": ["./src/module/ui/*"],
            "@scripts/*": ["./src/scripts/*"],
            "@common/*": ["./node_modules/@dfreds/foundry-types/common/*"],
            "@client/*": ["./node_modules/@dfreds/foundry-types/client/*"]
        },
        "types": ["node"],
        "typeRoots": ["./node_modules/@types"]
    },
    "include": ["src/**/*", "src/**/*.svelte", "tests/**/*"],
    "exclude": ["node_modules", "dist"]
}
