{
    "name": "sra2-wired",
    "version": "0.1.0",
    "private": true,
    "description": "PF2e Foundry VTT module template (hybrid content + scripted Svelte UI).",
    "license": "CC-BY-SA-4.0",
    "type": "module",
    "scripts": {
        "build": "node scripts/pack.ts && vite build",
        "clean": "rm -rf dist/*",
        "dev": "vite",
        "watch": "vite build --watch",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "setup": "node scripts/setup.ts",
        "deploy": "node scripts/deploy.ts",
        "pack": "fvtt package pack",
        "unpack": "fvtt package unpack",
        "normalize": "node scripts/normalize-refs.ts",
        "lint": "oxlint && oxfmt --check",
        "lint:oxlint": "oxlint",
        "lint:oxfmt": "oxfmt --check",
        "lint:fix": "oxlint --fix && oxfmt",
        "fmt": "oxfmt"
    },
    "dependencies": {
        "svelte": "^5.59.1"
    },
    "devDependencies": {
        "@dfreds/foundry-types": "^14.370.0",
        "@foundryvtt/foundryvtt-cli": "^3.0.5",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@types/node": "^26.6.6",
        "@vitest/ui": "^5.1.1",
        "oxfmt": "^0.79.0",
        "oxlint": "^1.94.0",
        "sass": "^1.108.2",
        "svelte-check": "^4.7.8",
        "tsrs": "7.1.0-beta.tsrs4",
        "typescript": "^6.0.2",
        "vite": "^8.3.8",
        "vite-plugin-static-copy": "^4.1.1",
        "vitest": "^5.1.1"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^24.22.3",
            "onFail": "download"
        }
    }
}
